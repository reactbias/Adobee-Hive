# Copy to .env for local runs. On AWS these live in App Runner (key in Secrets Manager).
# Without a key everything still works in offline mode (scripted agent, keyword search).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5
# off disables server-side refusal fallbacks
CLAUDE_FALLBACKS=default
# Federate: let the agent search other Hives too (comma-separated MCP URLs)
HIVE_MCP_URLS=
AGENT_MAX_TURNS=10
CORS_ORIGINS=*
# s3://bucket/abh.duckdb to keep data across App Runner deploys
DUCKDB_S3_URI=
SEED_ON_EMPTY=true
