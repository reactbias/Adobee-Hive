# Copy to .env for local runs. In the cloud these are set in the Render dashboard.
# Without a key everything still works in offline mode (scripted agent, rule-based edits, rule-check second opinion).
# The demo's key: OpenAI runs the booking agent, owner edits and the second opinion.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional alternative: Claude. Used only if there is no OpenAI key, or with LLM_PROVIDER=claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5
# off disables server-side refusal fallbacks
CLAUDE_FALLBACKS=default
# openai, claude or offline; empty picks by which key is set
LLM_PROVIDER=
# Federate: let the agent search other Hives too (comma-separated MCP URLs)
HIVE_MCP_URLS=
# Peer Hives for hop-limited federated search (comma-separated base URLs, e.g. https://hive-zurich.example)
HIVE_PEER_URLS=
# This hub's id in a federated result's provenance chain and a query's loop-prevention list
HIVE_HUB_ID=local
# What this hub declares about how it vets members: signed, attested or none
HIVE_VERIFICATION=signed
AGENT_MAX_TURNS=10
CORS_ORIGINS=*
# Optional Postgres (postgresql://...) to keep data across redeploys; empty = local DuckDB file only
DATABASE_URL=
SEED_ON_EMPTY=true
# Set on the deployed backend so only the team can wipe the demo: curl -X POST -H "X-Demo-Token: ..." .../api/demo/reset
DEMO_RESET_TOKEN=
# Set on the deployed backend so only the team can edit cards in the owner studio (sent as X-Owner-Token)
OWNER_EDIT_TOKEN=
# Running the hub itself. Both are unset here on purpose: unset means administration is refused, never open, and a
# default in the repo would be a published one. Set them on the deployed backend only.
# ADMIN_TOKEN is the static secret for curl and CI; ADMIN_PASSWORD is what a person types in the admin panel.
ADMIN_TOKEN=
ADMIN_PASSWORD=
# How long an admin session token lasts, and the guessing budget for POST /api/admin/login
ADMIN_SESSION_MINUTES=30
ADMIN_LOGIN_PER_CLIENT=5
ADMIN_LOGIN_TOTAL=30
ADMIN_LOGIN_WINDOW_S=900
# Cost guard: calls that may reach Claude, per client IP and in total, per hour
LLM_CALLS_PER_CLIENT_HOUR=30
LLM_CALLS_TOTAL_HOUR=300
