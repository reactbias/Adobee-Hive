# Copy to .env for local runs. On AWS these live in App Runner (key in Secrets Manager).
# Without a key everything still works in offline mode (scripted agent, keyword search).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5
# off disables server-side refusal fallbacks
CLAUDE_FALLBACKS=default
# Optional: a sceptic agent on OpenAI checks each held booking. Without it a rule check answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Federate: let the agent search other Hives too (comma-separated MCP URLs)
HIVE_MCP_URLS=
AGENT_MAX_TURNS=10
CORS_ORIGINS=*
# s3://bucket/abh.duckdb to keep data across App Runner deploys
DUCKDB_S3_URI=
SEED_ON_EMPTY=true
# Set on the deployed backend so only the team can wipe the demo: curl -X POST -H "X-Demo-Token: ..." .../api/demo/reset
DEMO_RESET_TOKEN=
# Set on the deployed backend so only the team can edit cards in the owner studio (sent as X-Owner-Token)
OWNER_EDIT_TOKEN=
# Cost guard: calls that may reach Claude, per client IP and in total, per hour
LLM_CALLS_PER_CLIENT_HOUR=30
LLM_CALLS_TOTAL_HOUR=300
