# Docker Compose configuration. Copy to .env and replace the placeholders.
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_long_database_password
POSTGRES_DB=hr_database
# Built into the frontend. ADMIN_TOKEN must match backend/.env, and anyone who can open the portal can read both,
# so run this stack only where you trust everyone who can reach it.
HIRING_HUB_API_KEY=replace_with_organisation_api_key
ADMIN_TOKEN=replace_with_admin_token
