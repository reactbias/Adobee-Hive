# Copy this file to backend/.env and replace every placeholder.
OPENAI_API_KEY=replace_with_provider_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ADMIN_TOKEN=replace_with_admin_token

# Local development default. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./cv_analyzer.db
